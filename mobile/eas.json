{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://financetracker-ckvf.onrender.com",
        "EXPO_PUBLIC_TASKER_API_KEY": "FT-sms-2026-myTracker"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://financetracker-ckvf.onrender.com",
        "EXPO_PUBLIC_TASKER_API_KEY": "FT-sms-2026-myTracker"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
